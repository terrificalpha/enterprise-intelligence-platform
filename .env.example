# Copy to .env (or set as environment variables). The project runs 100% locally with Ollama: NO paid API key needed.

# --- LLM: local Ollama (default) ---
# LLM_PROVIDER=ollama                  # ollama | offline | (optional: anthropic | openai | auto)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b              # best fit for GTX 1650 4GB. Alternatives: llama3.2:3b, qwen2.5:1.5b (faster)
# OLLAMA_NUM_CTX=4096
# OLLAMA_KEEP_ALIVE=30m
# EIP_LLM_TIMEOUT=180                  # seconds; first call loads the model into VRAM

# --- Retrieval ---
# EIP_EMBEDDING=lsa                    # lsa (offline default) | ollama (ollama pull nomic-embed-text) | sentence-transformers
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EIP_SUPPORT_THRESHOLD=0.35           # evidence-confidence below this => "not enough evidence"

# --- API / security ---
# EIP_API_KEY=change-me                # if set, every protected endpoint requires header X-API-Key
# EIP_API_URL=http://localhost:8000
# EIP_RATE_LIMIT=120
# EIP_MAX_UPLOAD_MB=10
